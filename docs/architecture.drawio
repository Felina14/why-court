<mxfile host="app.diagrams.net"><diagram id="whycourt" name="Why Court architecture"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style='font-size:22px'&gt;⚖ Why Court · architecture&lt;/b&gt;&lt;br&gt;Strands Agents SDK on Amazon Bedrock · serverless on AWS (us-east-1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7ead1;strokeColor=#15110d;dashed=0;fontStyle=0;fontSize=13;align=center;verticalAlign=middle;arcSize=8;spacing=6;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1640" height="56" as="geometry"/></mxCell><mxCell id="c3" value="Child&lt;br&gt;&lt;span style='font-weight:normal'&gt;phone or desktop browser&lt;br&gt;6 languages · no account&lt;/span&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=1;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.mobile_client;" vertex="1" parent="1"><mxGeometry x="75" y="190" width="41" height="78" as="geometry"/></mxCell><mxCell id="c4" value="Teacher&lt;br&gt;&lt;span style='font-weight:normal'&gt;/teacher · class code + PIN&lt;/span&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=1;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.user;" vertex="1" parent="1"><mxGeometry x="66" y="470" width="60" height="60" as="geometry"/></mxCell><mxCell id="c5" value="AWS Cloud" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="190" y="80" width="1490" height="900" as="geometry"/></mxCell><mxCell id="c6" value="Region us-east-1 · deployed by one CloudFormation stack (deploy/deploy.sh)" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#00A4A6;dashed=1;" vertex="1" parent="1"><mxGeometry x="210" y="120" width="1450" height="840" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Amazon CloudFront&lt;/b&gt;&lt;br&gt;comic UI · HTTPS&lt;br&gt;CloudFront Function: /teacher" style="sketch=0;outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;fillColor=#8C4FFF;" vertex="1" parent="1"><mxGeometry x="270" y="175" width="56" height="56" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;S3 · UI bucket&lt;/b&gt;&lt;br&gt;private (origin access control)&lt;br&gt;HTML · JS · fonts · translations" style="sketch=0;outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;fillColor=#7AA116;" vertex="1" parent="1"><mxGeometry x="270" y="360" width="56" height="56" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Lambda function URL&lt;/b&gt;&lt;br&gt;HTTPS · CORS: only the CloudFront site&lt;br&gt;requests up to 15 min (a hearing)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#ED7100;dashed=0;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;arcSize=8;spacing=6;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="230" y="560" width="200" height="80" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;CloudFormation&lt;/b&gt;&lt;br&gt;template.yaml · least-privilege IAM role" style="sketch=0;outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudformation;fillColor=#E7157B;" vertex="1" parent="1"><mxGeometry x="270" y="790" width="56" height="56" as="geometry"/></mxCell><mxCell id="c11" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#ED7100;dashed=0;fontStyle=0;fontSize=12;align=center;verticalAlign=middle;arcSize=8;spacing=6;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="470" y="160" width="820" height="770" as="geometry"/></mxCell><mxCell id="c12" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;fillColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="485" y="170" width="40" height="40" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;AWS Lambda&lt;/b&gt; · Python 3.12 arm64 · FastAPI (Mangum) · the whole Strands court" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;dashed=0;fontStyle=0;fontSize=13;align=left;verticalAlign=middle;arcSize=8;spacing=6;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="530" y="172" width="700" height="30" as="geometry"/></mxCell><mxCell id="c14" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b3fa0;dashed=1;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;arcSize=8;spacing=6;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="490" y="215" width="780" height="330" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Strands Graph · the hearing&lt;/b&gt;  (conditional edges route on each ruling)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;dashed=0;fontStyle=0;fontSize=12;align=left;verticalAlign=middle;arcSize=8;spacing=6;fontColor=#6b3fa0;" vertex="1" parent="1"><mxGeometry x="500" y="220" width="620" height="26" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Usher&lt;/b&gt;&lt;br&gt;hook · BeforeNodeCall&lt;br&gt;is there a reason?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#6b3fa0;dashed=1;fontStyle=0;fontSize=11;align=center;verticalAlign=middle;arcSize=8;spacing=6;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="500" y="255" width="130" height="62" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Clerk&lt;/b&gt; node&lt;br&gt;is the answer right?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#1f8a4c;dashed=0;fontStyle=0;fontSize=11;align=center;verticalAlign=middle;arcSize=8;spacing=6;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="500" y="345" width="130" height="62" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Hearing · Swarm&lt;/b&gt;&lt;br&gt;Prosecutor ⇄ Defence&lt;br&gt;(handoffs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#e03b2f;dashed=0;fontStyle=0;fontSize=11;align=center;verticalAlign=middle;arcSize=8;spacing=6;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="680" y="345" width="150" height="62" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Judge&lt;/b&gt; node&lt;br&gt;test it, or close it?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#6b3fa0;dashed=0;fontStyle=0;fontSize=11;align=center;verticalAlign=middle;arcSize=8;spacing=6;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="880" y="345" width="130" height="62" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Narrator&lt;/b&gt;&lt;br&gt;hook · AfterNodeCall&lt;br&gt;the lines the child hears" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#6b3fa0;dashed=1;fontStyle=0;fontSize=11;align=center;verticalAlign=middle;arcSize=8;spacing=6;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="880" y="255" width="130" height="62" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Examiner&lt;/b&gt; node&lt;br&gt;tool &lt;b&gt;call_witness&lt;/b&gt; →&lt;br&gt;&lt;b&gt;tool_context.interrupt()&lt;/b&gt;&lt;br&gt;graph pauses until the child taps;&lt;br&gt;resumes on any server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fc;strokeColor=#1f6fd0;dashed=0;fontStyle=0;fontSize=11;align=center;verticalAlign=middle;arcSize=8;spacing=6;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1060" y="330" width="190" height="96" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Exact lesson&lt;/b&gt; (lessons.py)&lt;br&gt;sandbox-checked numbers&lt;br&gt;→ practice round" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#1f8a4c;dashed=0;fontStyle=0;fontSize=11;align=center;verticalAlign=middle;arcSize=8;spacing=6;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1060" y="450" width="190" height="70" as="geometry"/></mxCell><mxCell id="c23" value="outside the Rule Book:&lt;br&gt;Clerk → &lt;b&gt;Coach&lt;/b&gt; (Reason check)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=0;fontStyle=0;fontSize=11;align=center;verticalAlign=middle;arcSize=8;spacing=6;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="500" y="450" width="200" height="52" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#232F3E;dashed=0;fontSize=11;fontStyle=1;fontColor=#232F3E;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="trial" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#232F3E;dashed=0;fontSize=11;fontStyle=1;fontColor=#232F3E;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#232F3E;dashed=0;fontSize=11;fontStyle=1;fontColor=#232F3E;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6b3fa0;dashed=1;fontSize=11;fontStyle=1;fontColor=#6b3fa0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="cross_examine" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#232F3E;dashed=0;fontSize=11;fontStyle=1;fontColor=#232F3E;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c19" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="misconception_found" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#232F3E;dashed=0;fontSize=11;fontStyle=1;fontColor=#232F3E;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Strands hooks = the court's rules&lt;/b&gt; (HookProvider · Before/AfterToolCall · Before/AfterNodeCall)&lt;br&gt;no verdict without proof · lessons checked · exact answers stand · charged ideas always tested · hints swapped if they give the answer away · Kindness Officer on every child-facing line · live feed of each ruling to the phone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#0f766e;dashed=0;fontStyle=0;fontSize=11;align=center;verticalAlign=middle;arcSize=8;spacing=6;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="490" y="555" width="780" height="62" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Strands Graph · chapter check-up&lt;/b&gt;&lt;br&gt;Examiner node · same witness tool and interrupt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f6fd0;dashed=1;fontStyle=0;fontSize=11;align=center;verticalAlign=middle;arcSize=8;spacing=6;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="490" y="630" width="330" height="58" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Sandbox&lt;/b&gt; (isolated subprocess, no credentials)&lt;br&gt;Rule Book: 8 topics · 15 wrong ideas as &lt;b&gt;code&lt;/b&gt;&lt;br&gt;run both ways round · picks the question that rules ideas out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3d6;strokeColor=#b7791f;dashed=0;fontStyle=0;fontSize=11;align=center;verticalAlign=middle;arcSize=8;spacing=6;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="840" y="630" width="430" height="58" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Single-job Strands agents&lt;/b&gt;&lt;br&gt;Homework Reader (photo → structured output) · &lt;b&gt;Teach me: Explainer + Maths Expert (as_tool), lesson checked by a hook&lt;/b&gt; · Coach · Interpreter (6 languages, numbers locked) · Kindness Officer · Teacher Agent (reteach plan) · Book Indexer · Exercise Reader · Topic Finder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#232F3E;dashed=0;fontStyle=0;fontSize=11;align=center;verticalAlign=middle;arcSize=8;spacing=6;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="490" y="700" width="780" height="62" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;Strands extras:&lt;/b&gt; structured output · agents as tools · OpenTelemetry tracing · Court Reporter agent served over &lt;b&gt;A2A&lt;/b&gt; (A2AServer, separate process: scripts/staffroom.py)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontStyle=0;fontSize=11;align=center;verticalAlign=middle;arcSize=8;spacing=6;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="490" y="775" width="780" height="44" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Learning loop:&lt;/b&gt; lesson → practice round → worked example + 2 more tries → re-hearing day a week later · objection → re-heard with a fresh session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f7ee;strokeColor=#1f8a4c;dashed=0;fontStyle=0;fontSize=11;align=center;verticalAlign=middle;arcSize=8;spacing=6;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="490" y="830" width="780" height="44" as="geometry"/></mxCell><mxCell id="c36" value="rate limits · wrong-PIN lockout shared across copies · uploads: teacher only, own class" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;dashed=0;fontStyle=0;fontSize=11;align=center;verticalAlign=middle;arcSize=8;spacing=6;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="490" y="885" width="780" height="30" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;Amazon Bedrock&lt;/b&gt;&lt;br&gt;Nova Pro: US profile + in-region&lt;br&gt;Nova 2 Lite: US + global profile&lt;br&gt;spill-over when a route is busy" style="sketch=0;outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;fillColor=#01A88D;" vertex="1" parent="1"><mxGeometry x="1400" y="175" width="56" height="56" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Bedrock Guardrails&lt;/b&gt;&lt;br&gt;ApplyGuardrail on child text (PII)&lt;br&gt;+ on model calls · denied topics" style="sketch=0;outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;fillColor=#01A88D;" vertex="1" parent="1"><mxGeometry x="1400" y="360" width="56" height="56" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;Amazon Polly&lt;/b&gt;&lt;br&gt;voices for the court" style="sketch=0;outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.polly;fillColor=#01A88D;" vertex="1" parent="1"><mxGeometry x="1400" y="535" width="56" height="56" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;S3 · data bucket&lt;/b&gt; (private)&lt;br&gt;trials · classes · re-hearings · books&lt;br&gt;translations · live feed · indexes&lt;br&gt;&lt;b&gt;Strands S3SessionManager&lt;/b&gt;: paused trials" style="sketch=0;outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;fillColor=#7AA116;" vertex="1" parent="1"><mxGeometry x="1400" y="665" width="56" height="56" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;CloudWatch Logs&lt;/b&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;fillColor=#E7157B;" vertex="1" parent="1"><mxGeometry x="1400" y="860" width="56" height="56" as="geometry"/></mxCell><mxCell id="c42" value="loads the app" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#232F3E;dashed=0;fontSize=11;fontStyle=1;fontColor=#232F3E;labelBackgroun